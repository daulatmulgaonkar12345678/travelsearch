# ===================================================
# TravelSearch Provider Configuration
# ===================================================

# Amadeus API (Primary Flight & Hotel Provider)
# Get your credentials at: https://developers.amadeus.com/
AMADEUS_API_KEY=your_amadeus_api_key
AMADEUS_API_SECRET=your_amadeus_api_secret
AMADEUS_BASE_URL=https://test.api.amadeus.com
AMADEUS_ENVIRONMENT=test

# Duffel (Optional Secondary Flight Provider)
# Get your test token at: https://duffel.com/
DUFFEL_TEST_TOKEN=your_duffel_test_token
DUFFEL_ENVIRONMENT=test

# Travelpayouts / Aviasales (Affiliate Redirect)
# Sign up at: https://www.travelpayouts.com/
TRAVELPAYOUTS_AVIASALES_BASE_URL=https://aviasales.tpx.lt/your_marker
TRAVELPAYOUTS_MARKER=your_marker_id

# Provider Selection
# Options: amadeus, duffel, amadeus+duffel
FLIGHT_PROVIDER=amadeus
# Options: amadeus
HOTEL_PROVIDER=amadeus

# ===================================================
# Legacy Providers (Optional - for future expansion)
# ===================================================
LCC_API_KEY=REPLACE_ME
TRIP_API_KEY=REPLACE_ME
AGODA_API_KEY=REPLACE_ME
KIWI_API_KEY=REPLACE_ME

# ===================================================
# Communication Services
# ===================================================
SENDGRID_API_KEY=REPLACE_ME
RECAPTCHA_SITE_KEY=REPLACE_ME
RECAPTCHA_SECRET=REPLACE_ME

# ===================================================
# Database & Cache
# ===================================================
MONGODB_URI=mongodb://localhost:27017/metasearch
REDIS_URL=redis://localhost:6379

# ===================================================
# Security & Authentication
# ===================================================
JWT_SECRET=your-secret-key-change-in-production
ADMIN_TOTP_ISSUER=MetasearchPlatform

# ===================================================
# Application Settings
# ===================================================
NODE_ENV=development
CACHE_TTL=900
RATE_LIMIT_PER_MINUTE=100
