# Amadeus API (Flights + Hotels)
AMADEUS_API_KEY=your_amadeus_api_key
AMADEUS_API_SECRET=your_amadeus_api_secret
AMADEUS_ENVIRONMENT=test
AMADEUS_BASE_URL=https://test.api.amadeus.com

# Duffel (Flights - Test Only)
DUFFEL_TEST_TOKEN=your_duffel_test_token
DUFFEL_ENVIRONMENT=test
DUFFEL_BASE_URL=https://api.duffel.com

# Travelpayouts / Aviasales (Affiliate)
TRAVELPAYOUTS_AVIASALES_BASE_URL=https://aviasales.tpx.lt/eqOxwsZu
TRAVELPAYOUTS_MARKER=689331

# Provider Selection
FLIGHT_PROVIDER=amadeus
HOTEL_PROVIDER=amadeus

# MongoDB
MONGODB_URI=mongodb://localhost:27017/travelsearch

# Cache & Rate Limiting
CACHE_TTL=900
RATE_LIMIT_PER_MINUTE=100

# Application
NODE_ENV=development
JWT_SECRET=your-secret-key-change-in-production
