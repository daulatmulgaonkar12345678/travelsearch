# Production Environment Configuration
# =====================================
# 
# ARCHITECTURE: All browser API calls go through Next.js API routes
# Browser -> /api/* -> Next.js (server) -> Backend
# 
# This ensures:
# - No CORS errors
# - Works on all environments (localhost, preview, production)
# - Backend URL never exposed to browser

# Backend URL - ONLY used by Next.js API routes (server-side)
BACKEND_URL=https://travelsearch-backend.onrender.com

# Site URL for SEO metadata
NEXT_PUBLIC_SITE_URL=https://travelsearch.com
